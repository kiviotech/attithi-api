{
  "kind": "collectionType",
  "collectionName": "up_users",
  "info": {
    "name": "user",
    "description": "",
    "singularName": "user",
    "pluralName": "users",
    "displayName": "User"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "username": {
      "type": "string",
      "minLength": 3,
      "unique": true,
      "configurable": false,
      "required": true
    },
    "email": {
      "type": "email",
      "minLength": 6,
      "configurable": false,
      "required": true
    },
    "provider": {
      "type": "string",
      "configurable": false
    },
    "password": {
      "type": "password",
      "minLength": 6,
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "resetPasswordToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmationToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "role": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.role",
      "inversedBy": "users",
      "configurable": false
    },
    "user_role": {
      "type": "enumeration",
      "enum": [
        "super-admin",
        "donation",
        "deeksha",
        "guest-house",
        "donation-admin"
      ],
      "default": "deeksha"
    },
    "receipt_details": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::receipt-detail.receipt-detail",
      "mappedBy": "createdby"
    },
    "counter": {
      "type": "enumeration",
      "enum": [
        "Counter 1",
        "Counter 2",
        "Counter 3",
        "Counter 4"
      ]
    },
    "stopCommunication": {
      "type": "boolean",
      "default": false,
      "description": "Flag to indicate if communication should be stopped with this user"
    },
    "communicationStopReason": {
      "type": "enumeration",
      "enum": [
        "Unsubscribed",
        "Bounced Email",
        "Complaint",
        "Invalid Contact",
        "Requested Removal",
        "Other"
      ],
      "description": "Reason for stopping communication with this user"
    }
  }
}
