{
  "/email-template/booking-confirmation": {
    "post": {
      "tags": [
        "Email Template"
      ],
      "operationId": "post/email-template/booking-confirmation",
      "description": "Send booking confirmation email",
      "parameters": [],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "required": ["email", "bookingId", "name"],
                  "properties": {
                    "bookingId": {
                      "type": "string",
                      "description": "Unique booking identifier"
                    },
                    "name": {
                      "type": "string",
                      "description": "Guest name"
                    },
                    "email": {
                      "type": "string",
                      "format": "email",
                      "description": "Guest email address"
                    },
                    "checkInDate": {
                      "type": "string",
                      "format": "date",
                      "description": "Check-in date (YYYY-MM-DD)"
                    },
                    "checkOutDate": {
                      "type": "string",
                      "format": "date",
                      "description": "Check-out date (YYYY-MM-DD)"
                    },
                    "numberOfGuests": {
                      "type": "integer",
                      "description": "Number of guests"
                    },
                    "purpose": {
                      "type": "string",
                      "description": "Purpose of stay"
                    },
                    "accommodationType": {
                      "type": "string",
                      "enum": [
                        "guestHouse",
                        "dormitory",
                        "yatriNivasRoom",
                        "chinuShankhari",
                        "peerlessFlat"
                      ],
                      "description": "Type of accommodation"
                    }
                  }
                }
              }
            },
            "example": {
              "data": {
                "bookingId": "123",
                "name": "John Doe",
                "email": "john.doe@example.com",
                "checkInDate": "2024-03-20",
                "checkOutDate": "2024-03-22",
                "numberOfGuests": 2,
                "purpose": "Tourism",
                "accommodationType": "guestHouse"
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Email sent successfully",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "success": {
                    "type": "boolean",
                    "example": true
                  }
                }
              }
            }
          }
        },
        "400": {
          "description": "Bad request",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "error": {
                    "type": "string",
                    "example": "Missing required fields"
                  }
                }
              }
            }
          }
        },
        "500": {
          "description": "Server error",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "error": {
                    "type": "string",
                    "example": "Failed to send confirmation email"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
} 