      "target": "api::room.room",
      "inversedBy": "room_blockings"
    },
    "room_block_status": {
      "type": "enumeration",
      "enum": [
        "blocked",
        "unblocked",
        "cleaning underway",
        "maintenance"
      ]
    },
    "from_date": {
      "type": "date"
    },
    "to_date": {
      "type": "date"
    }
  }
}
