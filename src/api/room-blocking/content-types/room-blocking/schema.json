{
  "kind": "collectionType",
  "collectionName": "room_blockings",
  "info": {
    "singularName": "room-blocking",
    "pluralName": "room-blockings",
    "displayName": "RoomBlocking"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "reason_for_blocking": {
      "type": "text"
    },
    "room": {
      "type": "relation",
