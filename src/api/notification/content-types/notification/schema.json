{
  "kind": "collectionType",
  "collectionName": "notifications",
  "info": {
    "singularName": "notification",
    "pluralName": "notifications",
    "displayName": "Notification"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "status": {
      "type": "enumeration",
      "enum": [
        "sent",
        "pending"
      ]
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "Rejection",
        "Approval",
        "DONATION_EDITED",
        "DONATION_VERIFIED",
        "RECEIPT_EDITED",
        "info",
        "warning",
        "alert"
      ]
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "text"
    },
    "isRead": {
      "type": "boolean",
      "default": false
    },
    "sourceUserId": {
      "type": "integer"
    },
    "sourceUserName": {
      "type": "string"
    },
    "sourceUserRole": {
      "type": "string"
    },
    "targetRoles": {
      "type": "json"
    },
    "resourceType": {
      "type": "string"
    },
    "resourceId": {
      "type": "integer"
    },
    "booking_request": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::booking-request.booking-request",
      "inversedBy": "notifications"
    },
    "message_template": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::message-template.message-template",
      "inversedBy": "notifications"
    }
  }
}
