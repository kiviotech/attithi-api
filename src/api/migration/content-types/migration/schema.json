{
  "kind": "collectionType",
  "collectionName": "migrations",
  "info": {
    "singularName": "migration",
    "pluralName": "migrations",
    "displayName": "Migration",
    "description": "Data migration logs and tracking"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "jobId": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "processing",
        "completed",
        "failed",
        "cancelled"
      ],
      "default": "processing"
    },
    "progress": {
      "type": "integer",
      "min": 0,
      "max": 100,
      "default": 0
    },
    "results": {
      "type": "json"
    },
    "logs": {
      "type": "json"
    }
  }
} 